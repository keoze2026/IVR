# Where Django is. In Docker this is the internal service name, so the API key
# never crosses a public network.
IVR_API_BASE=http://localhost:8000

# Signs the session cookie. At least 32 chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# BFF port. Vite proxies /bff here in dev.
PORT=8787
