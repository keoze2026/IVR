# Container-network overrides, layered on top of ../.env.
#
# ../.env is written for running the app on the host, where Postgres and Redis
# are reachable on 127.0.0.1 at published ports. Inside the compose network
# they are service names on their standard ports instead, and the published
# host port is irrelevant. Compose applies env_file entries in order, so
# everything here wins over the same key in ../.env.
#
# Secrets stay in ../.env — nothing sensitive belongs in this file.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379
