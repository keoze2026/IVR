# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=q8d3A9gx6wIA1ppFda3WCV9JCpjfF8Fs15fpJH80kbf11DwhPdjeKMD2NHA74cXcQUs
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.com

# --- Database --------------------------------------------------------------
POSTGRES_DB=ivr
POSTGRES_USER=ivr
POSTGRES_PASSWORD=ivr
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Point at pgbouncer (transaction mode) in production and set CONN_MAX_AGE=0.
DB_CONN_MAX_AGE=0

# --- Redis (logical DB separation, see spec 3) -----------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB_BROKER=0
REDIS_DB_CACHE=1
REDIS_DB_CALLSTATE=2
REDIS_DB_CHANNELS=3
REDIS_DB_COUNTERS=4

# --- Compliance ------------------------------------------------------------
# Peppers the SHA-256 of every phone number. Rotating this invalidates every
# stored phone_hash — treat it as permanent.
PHONE_HASH_PEPPER=u-GTvNC3jFLE7t_GUSa8k_Ma7XXlExPcrQhlXvUZ25c
DEFAULT_REGION=US

# --- Object storage --------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
S3_BUCKET_UPLOADS=ivr-uploads
S3_BUCKET_PROMPTS=ivr-prompts
S3_BUCKET_RECORDINGS=ivr-recordings

# --- Twilio ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# --- Telnyx ----------------------------------------------------------------
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=

# --- Webhooks --------------------------------------------------------------
# Public base URL the carrier calls back on. Must be https in production.
PUBLIC_BASE_URL=https://api.example.com
# Comma-separated CIDRs allowed to hit /webhooks/. Empty disables the check
# (dev only — in production the WAF should enforce this too).
WEBHOOK_IP_ALLOWLIST=

# --- TTS -------------------------------------------------------------------
TTS_PROVIDER=polly
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
